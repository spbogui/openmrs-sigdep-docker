# ============================================================================
#  Configuration du site - copier en .env puis adapter :  cp .env.example .env
# ============================================================================

# Version de l'image spbogui/sigdep à utiliser
SIGDEP_VERSION=3.0.0

# Mots de passe MySQL (A CHANGER sur chaque site)
MYSQL_ROOT_PASSWORD=ChangezMoi_Root
OPENMRS_DB_USER=openmrs_user
OPENMRS_DB_PASSWORD=ChangezMoi_OpenMRS

# Mémoire Java d'OpenMRS
JAVA_XMS=2G
JAVA_XMX=4G

# Mémoire cache InnoDB de MySQL (≈ 25-40 % de la RAM du serveur)
MYSQL_INNODB_BUFFER=1G

# Port HTTP exposé par nginx
HTTP_PORT=80

# Données OpenMRS (modules, index lucene, logs...)
#   ./openmrs-data -> dossier sur le disque (Linux)
#   openmrs-data   -> volume Docker, plus rapide (recommandé sous Windows)
# Pour reprendre une ancienne installation cluster-sigdep : ./OpenMRS
OPENMRS_DATA_PATH=./openmrs-data

# Sauvegardes (dossier ./backups)
BACKUP_TIME=02:00
BACKUP_KEEP_DAYS=14

TZ=Africa/Abidjan
